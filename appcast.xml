<?xml version="1.0" encoding="utf-8"?>
<!--
  Sparkle appcast for FocusNow.

  This file is regenerated by the release workflow on every v* tag; do not
  hand-edit it. It is intentionally checked in with an empty <channel> so the
  feed URL resolves to valid XML from the very first app build onward. Sparkle
  reads an empty channel as "no update available", which is the correct answer
  before the first release exists — whereas a 404 surfaces to the user as an
  update-check error.
-->
<rss version="2.0" xmlns:sparkle="http://www.andymatuschak.org/xml-namespaces/sparkle">
  <channel>
    <title>FocusNow</title>
    <link>https://raw.githubusercontent.com/pritvikraj/focusnow-releases/main/appcast.xml</link>
    <description>Most recent FocusNow releases.</description>
    <language>en</language>
  </channel>
</rss>
